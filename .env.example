DEBUG=True
SECRET_KEY=change-me-to-a-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# docker-compose.yml reads DB_NAME, DB_USER, DB_PASSWORD, and DB_PORT from
# this file, so the container and Django always agree on the database and
# credentials. DB_HOST is only for Django and stays localhost.
DB_NAME=workshop_db
DB_USER=workshop_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
